# Copy this file to .env and fill in the provider used in class.
# Never commit a real API key.

# Choose one: local | gemini | openai | groq
# Use "local" until the class API key is available.
AI_PROVIDER=local

# Google Gemini (Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Local server port
PORT=3000
